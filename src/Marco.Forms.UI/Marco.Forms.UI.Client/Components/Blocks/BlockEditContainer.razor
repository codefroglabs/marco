@using Marco.Forms.UI.Client.Components.Actions
@using Marco.Forms.UI.Client.Models
@using Pure.Blazor.Components.Icons
@using Marco.Forms.UI.Client.Components.Controls
@using Marco.Forms.UI.Client.Components.Properties
<FloatingContainer @ref="contextMenuSelector" Icon="IconEllipsis" BoxPosition="BoxPosition.MiddleLeft">
    <BlockContextMenu OnCancel="contextMenuSelector.CloseMenu"
                      Block="@Block"
                      OnBlockAction="BlockActionSelected"/>
</FloatingContainer>

@code {
    private RenderFragment IconEllipsis => builder =>
    {
        builder.OpenComponent(0, typeof(PureIcon));
        builder.AddAttribute(1, nameof(PureIcon.Icon), PureIcons.IconEllipsis);
        builder.CloseComponent();
    };

    private RenderFragment GrabHandle => builder =>
    {
        builder.AddMarkupContent(0, "<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" class=\"h-4 w-4\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M10.05 4.575a1.575 1.575 0 1 0-3.15 0v3m3.15-3v-1.5a1.575 1.575 0 0 1 3.15 0v1.5m-3.15 0 .075 5.925m3.075.75V4.575m0 0a1.575 1.575 0 0 1 3.15 0V15M6.9 7.575a1.575 1.575 0 1 0-3.15 0v8.175a6.75 6.75 0 0 0 6.75 6.75h2.018a5.25 5.25 0 0 0 3.712-1.538l1.732-1.732a5.25 5.25 0 0 0 1.538-3.712l.003-2.024a.668.668 0 0 1 .198-.471 1.575 1.575 0 1 0-2.228-2.228 3.818 3.818 0 0 0-1.12 2.687M6.9 7.575V12m6.27 4.318A4.49 4.49 0 0 1 16.35 15m.002 0h-.002\" /></svg>");
    };
    [Inject]
    public required BlockDefinitionService BlockDefinitionService { get; set; }
    private FloatingContainer contextMenuSelector = null!;
    private FloatingContainer topBlockSelector = null!;
    private FloatingContainer bottomBlockSelector = null!;
    public BlockDefinition[] Blocks { get; set; } = [];

    protected override void OnInitialized()
    {
        Blocks = BlockDefinitionService.GetBlocks();
    }

    public async Task BlockActionSelected(BlockAction action)
    {
        contextMenuSelector.CloseMenu();
        await ActionSelected.InvokeAsync(action);
    }

    public async Task BlockSelected(BlockDefinition block)
    {
        bottomBlockSelector.CloseMenu();
        topBlockSelector.CloseMenu();

        // TODO: send 1) which block the action is for, 2) which block definition was selected, and 3) insert before/after
        var action = new InsertBlockAction(Block.BlockId)
        {
            BlockDefinition = block
        };

        await ActionSelected.InvokeAsync(action);
    }

    [Parameter] public required PageBlock Block { get; set; }

    [Parameter] public required EventCallback<BlockAction> ActionSelected { get; set; }
}
