<a href="/account/profile" class="group block flex-shrink-0 rounded-lg p-2 hover:bg-gray-100">
    <div class="flex items-center">
        <div class="p-2 rounded-full bg-gray-200 inline-block">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                 stroke="currentColor" class="h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/>
            </svg>
        </div>
        <div class="ml-3">
            <p class="text-sm font-medium text-gray-700 group-hover:text-gray-900">@_username</p>
            <p class="text-xs font-medium text-gray-500 group-hover:text-gray-700">View profile</p>
        </div>
    </div>
</a>

@code {
    private string _username = "ghost";

}
