@page "/forms/{FormId}/preview"
@using Marco.Forms.UI.Client.Models
@using Pure.Blazor.Components
@rendermode InteractiveServer

<div class="flex flex-col items-center justify-center h-full">
    <div class="mx-auto w-96 p-4 border-1 border-gray-300 rounded-xl shadow">
        @if (FormModel is null)
        {
            <p>Loading form...</p>
        }
        else
        {
            <Header2>@FormModel.Name</Header2>
            @if (submitted)
            {
                <p>Thank you! We've recorded your response.</p>
            }
            else
            {
                <EditForm class="flex flex-col gap-2" Model="@FormModel" Enhance="true"
                          OnValidSubmit="@HandleValidSubmit" FormName="@FormModel.Name">
                    <DataAnnotationsValidator/>
                    <ValidationSummary/>

                    @foreach (var formSection in FormModel.Sections)
                    {
                        <h4 class="text-xs text-gray-700">@formSection.Name</h4>
                        @if (!string.IsNullOrEmpty(formSection.Description))
                        {
                            <p>@formSection.Description</p>
                        }

                        @foreach (var field in formSection.Fields)
                        {
                            <FormFieldRenderer Field="field" />
                        }
                    }

                    <Button Variant="Variants.Primary" Size="Sizes.Sm" type="submit">Submit</Button>
                </EditForm>
            }
        }
    </div>
</div>

@code {
    bool submitted;
    [Inject] public required FormStore Store { get; set; }

    [SupplyParameterFromForm(FormName = "SearchForm")]
    public FormDto? FormModel { get; set; }

    [Parameter] public string? FormId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (FormModel is null)
        {
            FormModel = (await Store.GetFormsAsync()).FirstOrDefault(p => p.FormId == FormId);
        }
    }

    private void HandleValidSubmit()
    {
        if (FormModel is null)
        {
            return;
        }

        var formSubmissionId = Uuid.New();
        var submission = new FormSubmission(formSubmissionId, FormModel.FormId, Uuid.New())
        {
            Responses = []
        };

        // add all the responses to the submission
        foreach (var formSection in FormModel.Sections)
        {
            foreach (var q in formSection.Fields)
            {
                submission.Responses.Add(new FormResponse(Uuid.New(), formSubmissionId, q.FormFieldId!)
                {
                    Value = q.Value
                });
            }
        }

        Store.RecordSubmission(submission);
        submitted = true;
    }

}
