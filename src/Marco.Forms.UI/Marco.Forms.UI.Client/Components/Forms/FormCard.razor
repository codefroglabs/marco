@using Microsoft.FluentUI.AspNetCore.Components
<div @onclick=@OnClick
    class="group/form grid grid-cols-6 border-1 border-gray-200 hover:ring-2 ring-black/10 cursor-pointer rounded-lg items-center">
    <td class="px-6 py-4 whitespace-nowrap col-span-2">
        <div class="flex items-center">
            <div
                class="w-8 h-8 bg-purple-500 rounded-full flex items-center justify-center text-white">@(form.Name.FirstOrDefault())
            </div>
            <div class="ml-4 text-gray-700 font-medium">@form.Name</div>
        </div>
    </td>
    <td class="px-6 py-4 whitespace-nowrap text-gray-500">
        <a
            @onclick:stopPropagation
            class="group-hover/form:border-gray-200 hover:border-gray-400 border-1 border-transparent rounded px-3 py-0.5"
            href="/forms/@form.FormId/responses">
            @(form.Responses == 0 ? "-" : form.Responses)
        </a>
    </td>
    <td class="px-6 py-4 whitespace-nowrap text-gray-500">-</td>
    <td class="px-6 py-4 whitespace-nowrap text-gray-500">@form.Updated</td>
    <td class="px-6 py-4 whitespace-nowrap">
        <div class="flex justify-between space-x-2">
            <button
                @onclick:stopPropagation
                class="border-1 p-0.5 border-gray-200 hover:bg-gray-100 cursor-pointer hover:border-gray-300 rounded-lg flex items-center justify-center">
                <svg class="size-4" xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 512 512">
                    <!--!Font Awesome Pro 6.7.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2024 Fonticons, Inc.-->
                    <path class="fa-secondary" opacity=".4"
                          d="M32 384a96 96 0 1 0 192 0A96 96 0 1 0 32 384zM288 128a96 96 0 1 0 192 0 96 96 0 1 0 -192 0z"/>
                    <path class="fa-primary"
                          d="M128 32a96 96 0 1 0 0 192 96 96 0 1 0 0-192zM384 288a96 96 0 1 0 0 192 96 96 0 1 0 0-192z"/>
                </svg>
            </button>
            <button
                @onclick:stopPropagation
                class="opacity-0 group-hover/form:opacity-25 hover:opacity-100 w-6 h-6 cursor-pointer flex items-center justify-center group/more relative"
                id="form-menu-@form.FormId" @onclick="() => Open = true">
                <svg class="size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                    <path class="fa-secondary" opacity=".4"
                          d="M128 256a32 32 0 1 1 -64 0 32 32 0 1 1 64 0zm160 0a32 32 0 1 1 -64 0 32 32 0 1 1 64 0zm160 0a32 32 0 1 1 -64 0 32 32 0 1 1 64 0z"/>
                    <path class="fa-primary"
                          d="M416 288a32 32 0 1 1 0-64 32 32 0 1 1 0 64zm0-80a48 48 0 1 0 0 96 48 48 0 1 0 0-96zM256 288a32 32 0 1 1 0-64 32 32 0 1 1 0 64zm0-80a48 48 0 1 0 0 96 48 48 0 1 0 0-96zM128 256a32 32 0 1 1 -64 0 32 32 0 1 1 64 0zm-80 0a48 48 0 1 0 96 0 48 48 0 1 0 -96 0z"/>
                </svg>
            </button>
            <FluentMenu UseMenuService="true"
                        Anchor="@($"form-menu-{form.FormId}")"
                        @bind-Open="Open"
                        VerticalThreshold="170">
                <FluentMenuItem OnClick=@PreviewForm>Preview</FluentMenuItem>
                <FluentMenuItem OnClick=@ShowResponses>Responses</FluentMenuItem>
                <FluentMenuItem OnClick=@EditForm>Edit</FluentMenuItem>
            </FluentMenu>
        </div>
    </td>
</div>

@code {

    [Inject]
    public required NavigationManager Nav { get; set; }

    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public required FormDto form { get; set; }
    public bool Open { get; set; }

    private void PreviewForm()
    {
        Nav.NavigateTo($"/forms/{form.FormId}/preview");
    }

    private void EditForm()
    {
        Nav.NavigateTo($"/forms/{form.FormId}/canvas");
    }

    private void ShowResponses()
    {
        Nav.NavigateTo($"/forms/{form.FormId}/responses");
    }
}
